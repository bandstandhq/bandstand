# Copy this file to .env and adjust if needed. The defaults below match
# docker/compose.yml and work out of the box for local development.

# --- Postgres ---
DATABASE_URL=postgres://bandstand:bandstand@localhost:5432/bandstand

# --- Auth (apps/server) ---
# Used to sign sessions/JWTs. This is a dev-only placeholder — the server
# refuses to start with it unchanged when NODE_ENV=production (see
# apps/server/src/lib/envGuard.ts). Generate a real secret for anything
# beyond local dev:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me
BETTER_AUTH_URL=http://localhost:3001

# --- Mail (generic SMTP, used for password-reset emails) ---
# Mailpit (docker/compose.yml) accepts any credentials and exposes a web UI
# at http://localhost:8025 to view sent mail.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bandstand <no-reply@bandstand.local>"
# Hard ceiling on outbound password-reset emails per hour, across every
# account and IP combined (see apps/server/src/lib/passwordResetRateLimit.ts)
# — the actual scarce resource this protects is your mail provider's quota.
# 100/hour is generous for a small self-hosted instance; lower it if you're
# on a strict sending quota.
MAX_PASSWORD_RESET_EMAILS_PER_HOUR=100

# --- Auth: signup rate limit (apps/server/src/app.ts) ---
# Per-IP caps on new-account creation — registration has no invite gate, so
# this is what stands between an open /signup and account-farming. 20/hour,
# 100/day are the production defaults (commented out here, not set) —
# generous enough for several real members signing up from one shared
# address, tight enough to still catch a bot. Raise these for an automated
# test suite that signs up many throwaway accounts from one address in a
# short window (see .github/workflows/e2e-acceptance.yml), not for normal use.
# MAX_SIGNUPS_PER_HOUR=20
# MAX_SIGNUPS_PER_DAY=100

# --- Server ---
PORT=3001
HOCUSPOCUS_PORT=3002
# Origin(s) of the web app, for CORS + better-auth's trustedOrigins. Not to
# be confused with VITE_DEFAULT_SERVER_URL below, which points the other
# way. Also the origin(s) docker/compose.yml's minio-init service allows
# through MinIO's CORS config (see docs/adr/0007-content-addressed-files.md).
# Comma-separated if you need more than one (e.g. testing on a phone over
# the LAN — see CONTRIBUTING.md's "Testing on mobile devices" section):
#   WEB_ORIGIN=http://localhost:5173,http://192.168.1.50:5173
# Never a wildcard, in any environment — and in production this must
# resolve to exactly one real, non-private-network origin, enforced at
# startup (see apps/server/src/lib/envGuard.ts).
WEB_ORIGIN=http://localhost:5173

# --- Web Push (optional — see docs/adr/0012-web-push.md) ---
# Left unset by default: the server starts fine without them, it just
# never sends push notifications (logs a one-time notice at boot). Run
# `pnpm push:keys` to generate a real pair.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# --- Storage (MinIO/S3, for song attachments) ---
# The credentials below are dev-only placeholders, same convention as
# BETTER_AUTH_SECRET above — enforced the same way (see
# apps/server/src/lib/envGuard.ts). Generate real values for anything
# beyond local dev.
# MINIO_ENDPOINT is embedded directly into presigned upload/download URLs
# handed to the browser (docs/adr/0007-content-addressed-files.md — uploads
# go straight from browser to MinIO, never through the API server), so it
# must be an address the browser can actually reach, not just the server:
# when testing on a phone, that means your LAN address or a tunnel (see
# CONTRIBUTING.md's "Testing on mobile devices" section), not localhost.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=dev-only-changeme
MINIO_SECRET_KEY=dev-only-changeme
MINIO_BUCKET=bandstand
# Per-file upload limit in bytes. 50MB default.
MAX_FILE_SIZE_BYTES=52428800

# --- Web (apps/web) ---
# The server URL is configurable per the sync architecture (docs/ARCHITECTURE.md) —
# this is only the *default* baked in at build time; each client can override it
# at runtime (e.g. to point at a self-hosted or LAN server). Left as
# localhost here even for LAN testing: apps/web/src/lib/networkHost.ts
# swaps a loopback host for whatever host the page was actually opened
# from, so opening the app via a LAN address just works without editing
# this file (see CONTRIBUTING.md's "Testing on mobile devices" section).
VITE_DEFAULT_SERVER_URL=http://localhost:3001
VITE_DEFAULT_HOCUSPOCUS_URL=ws://localhost:3002
# Vite's dev server rejects any request whose Host header it doesn't
# recognize; a LAN IP is allowed automatically, but a tunnel hostname (e.g.
# cloudflared's *.trycloudflare.com) isn't. Only needed for the HTTPS-tunnel
# case in CONTRIBUTING.md's "Testing on mobile devices" section — leave
# unset otherwise. A leading dot matches any subdomain.
# VITE_DEV_ALLOWED_HOSTS=.trycloudflare.com
